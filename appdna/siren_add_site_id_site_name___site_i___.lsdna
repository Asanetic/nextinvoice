$arr_tbl_ = mysqli_query($single_conn, "SHOW TABLES FROM `$dbname`");

$tbl_array=array();

while($arr_tbl_res_=mysqli_fetch_array($arr_tbl_))
{
  $tbl_array[]=$arr_tbl_res_[0];
}


print_r($tbl_array);

foreach($tbl_array as $tb_name_)
{
 
  if($tb_name_!="")
  {
   alter_table($mysqliconn, $dbname, $tb_name_, 'ADD column `hive_site_id` varchar(500) not null');
   alter_table($mysqliconn, $dbname, $tb_name_, 'ADD column `hive_site_name` varchar(500) not null');
  }
}